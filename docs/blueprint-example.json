    "description": "Complete operations blueprint for TradeCo, a quantitative trading firm with research, execution, and support functions."
  },
  "departments": [
    {
      "id": "dept-research",
      "name": "Research & Strategy",
      "owner": "Bob Martinez",
      "members": 5,
      "description": "Develops and backtests trading strategies, analyzes market data, optimizes entry/exit logic.",
      "processes": ["proc-backtest", "proc-signal-generation"],
      "tools": ["tool-backtrader", "tool-jupyter", "tool-github", "tool-bloomberg"]
    },
    {
      "id": "dept-execution",
      "name": "Execution & Operations",
      "owner": "Carol Zhang",
      "members": 3,
      "description": "Manages live trading, monitor positions, executes trades, manages risk.",
      "processes": ["proc-live-execution", "proc-risk-monitoring"],
      "tools": ["tool-ib", "tool-slack", "tool-datadog", "tool-trade-journal"]
    },
    {
      "id": "dept-support",
      "name": "Business Operations",
      "owner": "David Lee",
      "members": 2,
      "description": "Handles admin, compliance, infrastructure, financial reporting.",
      "processes": ["proc-pnl-reporting", "proc-tool-management"],
      "tools": ["tool-stripe", "tool-quickbooks", "tool-google-workspace", "tool-aws"]
    }
  ],
  "processes": [
    {
      "id": "proc-backtest",
      "name": "Strategy Backtesting",
      "category": "internal",
      "owner": "Bob Martinez",
      "description": "Test new trading strategies against historical data to validate edge before live trading.",
      "steps": [
        {
          "number": 1,
          "title": "Define strategy rules and parameters",
          "owner": "Quant Researcher",
          "tools": ["tool-jupyter"],
          "duration": "2-8 hours"
        },
        {
          "number": 2,
          "title": "Load historical price data",
          "owner": "Quant Researcher",
          "tools": ["tool-backtrader", "tool-bloomberg"],
          "duration": "30 minutes"
        },
        {
          "number": 3,
          "title": "Run backtest and analyze results",
          "owner": "Quant Researcher",
          "tools": ["tool-backtrader"],
          "duration": "1-4 hours"
        },
        {
          "number": 4,
          "title": "Document findings and decision",
          "owner": "Quant Researcher",
          "tools": ["tool-github"],
          "duration": "1 hour"
        }
      ],
      "frequency": "multiple times per week",
      "kpi": {
        "metric": "Backtest win rate",
        "target": "> 55%",
        "current": "58.3%"
      }
    },
    {
      "id": "proc-signal-generation",
      "name": "Daily Signal Generation",
      "category": "internal",
      "owner": "Bob Martinez",
      "description": "Generate trading signals each day based on deployed strategies and current market conditions.",
      "steps": [
        {
          "number": 1,
          "title": "Collect and validate overnight market data",
          "owner": "Signal Processor",
          "tools": ["tool-backtrader"],
          "duration": "15 minutes"
        },
        {
          "number": 2,
          "title": "Run strategy models",
          "owner": "Signal Processor",
          "tools": ["tool-backtrader"],
          "duration": "30 minutes"
        },
        {
          "number": 3,
          "title": "Generate signal summary for execution team",
          "owner": "Signal Processor",
          "tools": ["tool-slack"],
          "duration": "15 minutes"
        }
      ],
      "frequency": "daily before market open",
      "kpi": {
        "metric": "Signal generation SLA",
        "target": "< 1 hour before market open",
        "current": "45 minutes"
      }
    },
    {
      "id": "proc-live-execution",
      "name": "Live Trade Execution",
      "category": "internal",
      "owner": "Carol Zhang",
      "description": "Execute approved trades with risk controls, optimal order sizing, and real-time monitoring.",
      "steps": [
        {
          "number": 1,
          "title": "Review and approve trade signals",
          "owner": "Execution Lead",
          "tools": ["tool-slack", "tool-trade-journal"],
          "duration": "10 minutes"
        },
        {
          "number": 2,
          "title": "Calculate position size and risk allocation",
          "owner": "Risk Manager",
          "tools": ["tool-trade-journal"],
          "duration": "5 minutes"
        },
        {
          "number": 3,
          "title": "Submit order to Interactive Brokers",
          "owner": "Execution Operator",
          "tools": ["tool-ib"],
          "duration": "2 minutes"
        },
        {
          "number": 4,
          "title": "Monitor position and adjust if needed",
          "owner": "Execution Operator",
          "tools": ["tool-ib", "tool-datadog"],
          "duration": "ongoing"
        }
      ],
      "frequency": "per trade signal",
      "kpi": {
        "metric": "Execution slippage (avg)",
        "target": "< 1 bp",
        "current": "0.8 bp"
      }
    },
    {
      "id": "proc-risk-monitoring",
      "name": "Real-Time Risk Monitoring",
      "category": "internal",
      "owner": "Carol Zhang",
      "description": "Continuously monitor portfolio risk, drawdowns, and position limits with automated alerts.",
      "steps": [
        {
          "number": 1,
          "title": "Stream live P&L and position data",
          "owner": "Monitoring System",
          "tools": ["tool-datadog"],
          "duration": "continuous"
        },
        {
          "number": 2,
          "title": "Check against risk limits",
          "owner": "Monitoring System",
          "tools": ["tool-datadog"],
          "duration": "continuous"
        },
        {
          "number": 3,
          "title": "Alert execution team on threshold breach",
          "owner": "Monitoring System",
          "tools": ["tool-slack"],
          "duration": "instant"
        }
      ],
      "frequency": "real-time",
      "kpi": {
        "metric": "Alert accuracy (true positives)",
        "target": "> 95%",
        "current": "97.2%"
      }
    },
    {
      "id": "proc-pnl-reporting",
      "name": "P&L Reporting & Reconciliation",
      "category": "outbound",
      "owner": "David Lee",
      "description": "Daily and monthly P&L reporting, reconciliation with broker statements, performance attribution.",
      "steps": [
        {
          "number": 1,
          "title": "Pull end-of-day positions from broker",
          "owner": "Finance Analyst",
          "tools": ["tool-ib", "tool-quickbooks"],
          "duration": "30 minutes"
        },
        {
          "number": 2,
          "title": "Calculate P&L and reconcile to internal records",
          "owner": "Finance Analyst",
          "tools": ["tool-quickbooks"],
          "duration": "1 hour"
        },
        {
          "number": 3,
          "title": "Generate daily report for stakeholders",
          "owner": "Finance Analyst",
          "tools": ["tool-google-workspace"],
          "duration": "1 hour"
        },
        {
          "number": 4,
          "title": "Monthly performance review and attribution",
          "owner": "Finance Manager",
          "tools": ["tool-quickbooks"],
          "duration": "4 hours"
        }
      ],
      "frequency": "daily (summary), monthly (detailed)",
      "kpi": {
        "metric": "Reconciliation accuracy",
        "target": "100%",
        "current": "100%"
      }
    },
    {
      "id": "proc-tool-management",
      "name": "Technology & Tool Management",
      "category": "internal",
      "owner": "David Lee",
      "description": "Manage software subscriptions, licenses, upgrades, and cost tracking.",
      "steps": [
        {
          "number": 1,
          "title": "Track all tool subscriptions and renewal dates",
          "owner": "Tech Manager",
          "tools": ["tool-google-workspace"],
          "duration": "1 hour per month"
        },
        {
          "number": 2,
          "title": "Review tool usage and cost optimization",
          "owner": "CFO",
          "tools": ["tool-datadog"],
          "duration": "2 hours per month"
        },
        {
          "number": 3,
          "title": "Evaluate new tools or replacement candidates",
          "owner": "Tech Manager",
          "tools": ["tool-github"],
          "duration": "varies"
        }
      ],
      "frequency": "monthly review, ad-hoc evaluations",
      "kpi": {
        "metric": "Tool cost per trade",
        "target": "< $0.50",
        "current": "$0.35"
      }
    }
  ],
