  "changes": [
    {
      "id": "chg-001",
      "date": "2026-07-15",
      "title": "Implemented automated risk monitoring with Datadog",
      "description": "Replaced manual daily risk checks with continuous Datadog alerts for position limits, drawdowns, and margin usage. Reduced alert detection time from 1+ hours to instant.",
      "category": "tool",
      "impact": "Execution team now gets real-time alerts instead of manual daily review",
      "author": "Carol Zhang",
      "status": "completed"
    },
    {
      "id": "chg-002",
      "date": "2026-06-01",
      "title": "Migrated from in-house backtest framework to Backtrader",
      "description": "Standardized on open-source Backtrader to reduce maintenance burden and improve reproducibility. All strategies ported, documentation created.",
      "category": "tool",
      "impact": "Research team can now share and version strategies more easily",
      "author": "Bob Martinez",
      "status": "completed"
    },
    {
      "id": "chg-003",
      "date": "2026-05-10",
      "title": "Added structured Trade Journal for pre-trade commitment",
