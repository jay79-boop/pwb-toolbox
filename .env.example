# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Datasets. load_dataset falls back to the Hugging Face Hub, then yfinance.
PWB_API_KEY=

# 21st.dev, for the "21st" MCP server in .mcp.json.
# Key: https://21st.dev/settings/api-keys
#
# NOTE: Claude Code expands ${API_KEY_21ST} in .mcp.json from its own process
# environment and does NOT read this file. Putting the key here is not enough.
#
# Local sessions — export it before launching Claude Code:
#
#     set -a; . .env; set +a     # or put `export API_KEY_21ST=...` in your shell profile
#
# Claude Code on the web — there is no shell profile, so set it in the cloud
# environment's "Environment variables" field (environment dialog at
# claude.ai/code). That environment also needs Custom network access with
# 21st.dev in "Allowed domains", and note that cloud environments have no
# secrets store — anyone using the environment can read the value. See the
# "Design tooling (UI/UX)" section of CLAUDE.md.
#
API_KEY_21ST=

# NVIDIA's hosted model API, for tools/nvidia_vision.py.
# Key: https://build.nvidia.com/
#
# Read from the process environment like every other key here. Note that
# NVIDIA's published snippet writes "Bearer $NVIDIA_API_KEY" as a Python string
# literal, which does not expand and answers 401 -- see docs/nvidia-vision.md.
NVIDIA_API_KEY=
